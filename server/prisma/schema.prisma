generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SEEKER
  OWNER
}

enum PropertyType {
  APARTMENT
  HOUSE
  CONDO
  LAND
  COMMERCIAL
  OTHER
}

enum ListingType {
  RENT
  SALE
}

enum PropertyStatus {
  DRAFT
  PUBLISHED
  RENTED
  SOLD
}

enum InquiryStatus {
  NEW
  CONTACTED
  CLOSED
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String
  passwordHash String
  role         UserRole   @default(SEEKER)
  properties   Property[]
  inquiries    Inquiry[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([email, role])
  @@index([role])
}

model Property {
  id           String          @id @default(cuid())
  ownerId      String
  title        String
  description  String
  propertyType PropertyType
  listingType  ListingType
  price        Decimal         @db.Decimal(12, 2)
  location     String
  address      String
  bedrooms     Int
  bathrooms    Int
  features     String[]        @default([])
  status       PropertyStatus  @default(PUBLISHED)
  owner        User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  images       PropertyImage[]
  inquiries    Inquiry[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([status, createdAt])
  @@index([propertyType, listingType, price])
  @@index([location])
  @@index([ownerId])
}

model PropertyImage {
  id         String   @id @default(cuid())
  propertyId String
  url        String
  publicId   String
  position   Int      @default(0)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([propertyId, position])
}

model Inquiry {
  id         String        @id @default(cuid())
  propertyId String
  userId     String
  message    String
  status     InquiryStatus @default(NEW)
  property   Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([propertyId, createdAt])
  @@index([userId, createdAt])
  @@index([status])
}
